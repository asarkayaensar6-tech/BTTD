+BTDD V30.54 — Sade ayarlar ve ekran metinleri
+
+- Ana ekrandaki “İyi çalışmalar” ve yönlendirme paragrafı kaldırıldı; işlem kartları korundu.
+- Kullanılmayan, ekranda gizli eski kenar menüsü kaldırıldı; mevcut ana menü navigasyonu değişmedi.
+- Masa kartı bilgi seçenekleri ile sarı/kırmızı servis uyarı süreleri tek ayar panelinde birleştirildi. Kontrol kimlikleri, eşik değerleri, kayıt davranışı ve senkron akışı korundu.
+- Birleştirme ve toplu silme işlemlerinin ilk adımları, PIN/son onay adımlarından ayırt edilecek şekilde adlandırıldı. İkinci onay ve güvenlik korumaları yerinde.
+- Müşteriye gösterilen fiş selamlaması korundu.
+
+Doğrulama: ayar sadeleştirme regresyon testi ve V30.53 mevcut test takımı çalıştırılacak. Gerçek tarayıcı ekran görüntüsü veya fiziksel cihaz testi bu değişiklik için yapılmadı.
--- /dev/null
+++ b/tests/test_settings_cleanup.cjs
@@ -0,0 +1,29 @@
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const html=fs.readFileSync(__dirname+'/../index.html','utf8');
+const control=fs.readFileSync(__dirname+'/../BTDD_KONTROL.py','utf8');
+const section=html.slice(html.indexOf('<h3>Masa kartları ve servis uyarıları</h3>'),html.indexOf('<article class="setting-panel settings-visible" data-settings-group="general"><h3>◫ Saydam Arayüz</h3>'));
+assert(section.length>0,'merged settings panel exists');
+for(const id of ['optShowServiceWarnings','warnMinutes','alertMinutes','saveServiceTimes']){
+  assert.equal((html.match(new RegExp(`id="${id}"`,'g'))||[]).length,1,`${id} remains unique`);
+  assert(section.includes(`id="${id}"`),`${id} is inside the consolidated panel`);
+}
+assert(!html.includes('<h3>Servis renk süreleri</h3>'));
+assert(!html.includes('İyi çalışmalar.'));
+assert(!html.includes('BTDD yönetim merkezinden yapmak istediğin işlemi seç.'));
+assert(!html.includes('<aside class="sidebar">'));
+assert(!html.includes('data-view="tables"'));
+assert(html.includes('Afiyet olsun, yine bekleriz :)'),'customer receipt greeting remains intact');
+assert(html.includes('function renderSettingsTab()'),'settings tab logic remains');
+assert(html.includes("$('#saveServiceTimes').onclick"),'service-time save handler remains');
+assert(html.includes("$('#confirmMergeTable').onclick"),'merge confirmation handler remains');
+assert(html.includes("$('#confirmBulkDeleteProducts').onclick"),'PIN-gated bulk delete confirmation remains');
+assert(html.includes('id="mergeTable">Masa Seç</button>'));
+assert(html.includes('id="confirmMergeTable">Masaları Birleştir</button>'));
+assert(html.includes('id="bulkDeleteProducts" hidden>Silme Onayı</button>'));
+assert(html.includes('id="confirmBulkDeleteProducts">Seçilenleri Sil</button>'));
+const ids=[...html.matchAll(/\bid="([^"]+)"/g)].map(x=>x[1]);
+const dup=ids.filter((id,i)=>ids.indexOf(id)!==i);
+assert.deepEqual([...new Set(dup)],[],'HTML ids stay unique');
+assert(control.includes('V30.54 sade ayarlar'));
+console.log('Settings cleanup: merged controls, filler removal, unique IDs, and guarded two-step actions verified');
